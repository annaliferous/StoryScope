  <ListItems>
    <ListItem Color="#EBEB62627B7B" Id="82c0de7f-2f76-4237-9f39-3f4a9ef0ad67" Title="Bond is shot" Type="Beat">
      <SubordinateTo Length="0.625" Level="Outline 1" Number="7.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.61" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">Eve accidentally shoots Bond, who is in a fist fight with an enemy. Bond falls into the river and is believed dead.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Id="e5fc8ec6-eff6-4225-8854-3d5bbae38eb3" Title="dab.PNG" Type="Beat">
      <SubordinateTo Length="1.375" Level="Outline 2" Number="13.125" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="2.89" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Picture Height="187" Id="6373fb20-9513-4966-8161-333f0a55c998" Width="219"/>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#E5E5CBCB6C6C" Id="8e51f932-e291-4a4c-927c-d7bdb760d21e" Title="Alternate intro" Type="Beat">
      <SubordinateTo Length="2.000" Level="Outline 2" Number="0.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="2.50" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">Intro in medias res, skip the scene with Ronson</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Id="0326e112-55c4-46f7-a0fd-d7a5515ae6ba" Title="Title sequence" Type="Beat">
      <SubordinateTo Length="5.500" Level="Outline 1" Number="7.625" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.61" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">TODO:</Text>
        </Paragraph>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.61" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">- Call Adele</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Color="#E5E5CBCB6C6C" Id="43ac7fb9-bfc0-49a8-8156-3429c3966ab3" Title="Bond struggles to decide" Type="Beat">
      <SubordinateTo Length="1.250" Level="Outline 1" Number="0.000" Order="0" Type="PageGoal"/>
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.61" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">Bond finds </Text>
          <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">Ronson</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style=""> injured, has to leave him behind to chase the bad guys. First hint at disagreements between Bond and M.</Text>
        </Paragraph>
      </Content>
    </ListItem>
    <ListItem Id="891f626e-c0be-4a1f-a967-fc2ea889d1c9" Title="Action scene" Type="Beat">
      <Content>
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="3.61" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">Motorcycle chase through Istanbul</Text>
        </Paragraph>
      </Content>
    </ListItem>
